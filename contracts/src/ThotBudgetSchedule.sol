pragma solidity ^0.8.30;

/// Canonical floor(50m * 1e18 * (1 - 2^(-day/180))) for day 0..360.
/// Generated with Decimal precision 100; independently checked at precision 200 in tests.
library ThotBudgetSchedule {
    bytes internal constant CUMULATIVE = hex"";
    function cumulative(uint256 day) internal pure returns (uint256 value) {
        require(day <= 360, "DAY");
        bytes memory schedule = CUMULATIVE;
        assembly { value := shr(160, mload(add(add(schedule, 32), mul(day, 12)))) }
    }
    function dayCap(uint256 day) internal pure returns (uint256) {
        require(day < 360, "SUNSET");
        return cumulative(day + 1) - cumulative(day);
    }
}
