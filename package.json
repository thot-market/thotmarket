{
  "name": "thotmarket",
  "version": "0.3.0-rc.3",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build-privy-auth.mjs",
    "build:auth": "node scripts/build-privy-auth.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node scripts/build-privy-auth.mjs && node apps/api/server.ts",
    "worker": "node apps/worker/main.ts",
    "test": "node scripts/run-public-tests.mjs unit",
    "test:contracts": "node scripts/run-public-tests.mjs contracts",
    "test:evidence": "node scripts/run-public-tests.mjs evidence",
    "test:browser": "node scripts/run-public-tests.mjs browser",
    "test:packaging": "node scripts/run-public-tests.mjs packaging",
    "test:all": "node scripts/run-public-tests.mjs all",
    "check": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1135.0",
    "@clerk/backend": "3.17.1",
    "@electric-sql/pglite": "^0.5.8",
    "@privy-io/react-auth": "3.42.0",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "esbuild": "0.27.4",
    "ethers": "6.15.0",
    "pg": "^8.23.0",
    "playwright-core": "1.58.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.33",
    "@uniswap/v2-core": "1.0.1",
    "@uniswap/v2-periphery": "1.1.0-beta.0",
    "solc": "0.8.30"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "@reown/appkit",
      "bufferutil",
      "keccak",
      "utf-8-validate"
    ],
    "overrides": {
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "axios@>=1.0.0 <1.18.0": "1.18.0"
    }
  },
  "license": "MIT"
}
