{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "erasableSyntaxOnly": true, "noEmit": true, "allowImportingTsExtensions": true,
    "skipLibCheck": true, "types": ["node"], "lib": ["ES2023", "DOM"]
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "work", "contracts"]
}
